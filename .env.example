# Local PostgreSQL settings (used only when DATABASE_URL is not set)
DB_USER=postgres
DB_HOST=localhost
DB_NAME=upsc_tracker
DB_PASSWORD=replace_me
DB_PORT=5432

# Optional production-style connection settings
DATABASE_URL=
SESSION_SECRET=replace_with_a_long_random_secret
CRON_SECRET=replace_with_a_different_long_random_secret

# Optional integrations
OPENAI_API_KEY=
GNEWS_API_KEY=
EMAIL_USER=
EMAIL_PASS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
